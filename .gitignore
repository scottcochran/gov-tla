*_TTrace_*.bin

# Prover cache
.tlacache/

# Python (uv)
.venv/
__pycache__/

# Raw TLC dumps kept by visualize_states.py --keep-dot
*_states_depth*.dot

# Fresh results files CI writes with --out, compared with results/ and never committed
out/

# macOS Finder metadata
.DS_Store
