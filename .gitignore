metadir/
*.old

# Locally installed TLA+ tools (install-tla.sh, tools/install-tlaps.sh). The pins
# and wrappers in tools/ are tracked; the binaries are not.
tools/tla2tools.jar
tools/tlaps-*/

# Trace files TLC writes beside a module after a counterexample
